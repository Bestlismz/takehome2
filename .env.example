# Keep real values in the ignored root .env.local.
OPENAI_API_KEY=
# Native development. Docker Compose supplies its own service address.
LUKLAAN_DATABASE_URL=dbname=luklaan_dev host=localhost
# Optional comma-separated browser origins for an explicitly configured host.
LUKLAAN_ALLOWED_ORIGINS=
# Optional outbound greeting test. Disabled until all values are configured.
# Real values belong only in ignored .env.local. Use E.164 numbers (+countrycode...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LUKLAAN_TEST_PHONE=
LUKLAAN_ENABLE_TEST_CALLS=0

# Optional reviewer credential gate for medication/report review. Never expose in client code.
LUKLAAN_CLINICIAN_REVIEW_TOKEN=
